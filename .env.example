# Required at production build AND runtime: your actual public HTTPS origin.
# No path, query, credentials or localhost. Missing/invalid production values fail.
# Optional for npm run dev only; development falls back to localhost with noindex.
SITE_URL=
# Copy the actual project ID and dataset from Sanity Manage.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=2026-10-09
# Optional future automatic YouTube integration; not used or required today.
YOUTUBE_API_KEY=
